# Copy to .env. Never commit real credentials.
POSTGRES_DB=ctf
POSTGRES_USER=ctf
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
CTF_DATABASE_URL=postgresql+psycopg://ctf:change-me-local-only@postgres:5432/ctf

MINIO_ROOT_USER=ctf-local-admin
MINIO_ROOT_PASSWORD=change-me-at-least-16-characters
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
CTF_BUCKET=ctf-private
CTF_OBJECT_STORE=minio
# For non-Docker/test use: CTF_OBJECT_STORE=local
CTF_OBJECT_STORE_PATH=.ctf-objects
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

API_PORT=8080
WEB_PORT=3000
NEXT_PUBLIC_CTF_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_USE_MOCKS=false
APP_ENV=development
LOG_LEVEL=info

# Security, integrity and retention defaults
ANONYMOUS_SESSION_TTL_HOURS=72
CTF_IDEMPOTENCY_POLICY=required
CTF_RATE_LIMIT_REQUESTS=600
CTF_TENANT_RATE_LIMIT_REQUESTS=3000
CTF_RATE_LIMIT_WINDOW_SECONDS=60
CTF_AI_DAILY_TOKEN_QUOTA=1000000
CTF_AI_DAILY_COST_QUOTA_USD=100
CTF_MAX_REQUEST_BODY_BYTES=1048576
CTF_MAX_UPLOAD_BYTES=20971520
CTF_PRESIGN_TTL_SECONDS=300
# noop is development-only. Production should use clamav.
CTF_MALWARE_SCANNER=noop
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=10
ALLOWED_ATTACHMENT_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/plain,text/csv
ATTACHMENT_RETENTION_DAYS=30

# Optional provider-independent AI runtime. Supported explicit values:
# openai-compatible, ollama, fake. "fake" is non-production UX smoke-test data.
# There is never an automatic fake fallback.
AI_PROVIDER=
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_TIMEOUT_SECONDS=30
# JSON maps. Tier keys select models; pricing values are USD per million tokens.
AI_MODEL_MAP={"T1":"efficient","T2":"standard","T3":"critical","T4":"verification"}
AI_PRICING_MAP={}
AI_PRICE_SNAPSHOT_ID=unpriced
AI_T4_ENABLED=false

# Local Ollama mode. Host-run API default: http://localhost:11434. Compose API
# must use http://ollama:11434 (already supplied by compose.yaml).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_PORT=11434
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MODEL_T1=qwen2.5:3b
OLLAMA_MODEL_T2=qwen2.5:7b
OLLAMA_MODEL_T3=qwen2.5:14b
OLLAMA_MODEL_T4=qwen2.5:14b
OLLAMA_MODEL_MAP={}
# T1/T2 are enabled locally. T3/T4 require deliberate validation and opt-in.
AI_LOCAL_ALLOW_T3=false
AI_LOCAL_ALLOW_T4=false

# KHAL Garage Alpha is read-only and optional.
KHAL_ENABLED=false
KHAL_BASE_URL=
# Secret reference resolved server-side. env:// is supported by the default resolver.
KHAL_CREDENTIAL_REFERENCE=env://KHAL_READONLY_TOKEN
KHAL_READONLY_TOKEN=
# JSON map from CTF tenant IDs to KHAL tenant IDs. Prefer this for multi-tenant use.
KHAL_TENANT_MAP={}
# Optional single-tenant fallback; do not use for shared multi-tenant deployments.
KHAL_TENANT_ID=
KHAL_REQUEST_TIMEOUT_SECONDS=10
KHAL_PAGE_SIZE=100
KHAL_MAX_PAGES=100
KHAL_STALE_AFTER_SECONDS=300
